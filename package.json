{
  "name": "tonys-pizza-fantasy",
  "version": "0.0.0",
  "private": true,
  "description": "A persistent social game layered on Sleeper for one private ten-person fantasy football league.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run db:seed && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx scripts/verify-preflight.ts && npm run typecheck && npm run lint && npm run test && npm run build",
    "db:up": "bash scripts/dev-db.sh up",
    "db:visual": "DATABASE_URL= DB_NAME=tonys_visual bash scripts/dev-db.sh reset",
    "db:down": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "bash scripts/dev-db.sh reset",
    "db:fresh": "bash scripts/dev-db.sh fresh",
    "db:status": "bash scripts/dev-db.sh status",
    "demo": "tsx scripts/demo.ts",
    "sleeper:record": "tsx scripts/record-fixtures.ts",
    "sleeper:check": "tsx scripts/record-fixtures.ts -- --check",
    "sleeper:import": "tsx scripts/import-league.ts",
    "art:process": "tsx scripts/process-art.ts",
    "art:prepare": "tsx scripts/prepare-b0.ts",
    "art:prepare-incoming": "tsx scripts/prepare-incoming.ts",
    "art:validate": "tsx scripts/validate-collectible.ts",
    "visual:qa": "tsx scripts/visual-qa.mts",
    "visual:tony-glow": "tsx scripts/tony-glow-probe.mts && tsx scripts/tony-glow-frames.mts",
    "art:batch": "tsx scripts/art-batch.ts"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "next": "^15.5.4",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "playwright": "^1.56.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
